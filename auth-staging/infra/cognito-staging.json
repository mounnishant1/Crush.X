{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Prepared only: isolated Crush.X email/SRP authentication staging. Never imports or modifies the existing pool.",
  "Parameters": {
    "ApprovedAccountId": {
      "Type": "String",
      "AllowedPattern": "[0-9]{12}",
      "Description": "Separately approved staging AWS account ID; no default."
    },
    "OwnerLabel": {
      "Type": "String",
      "AllowedPattern": "[a-zA-Z0-9._-]{1,64}",
      "Description": "Staging owner label; no email or other personal data."
    },
    "TestWindowEnd": {
      "Type": "String",
      "AllowedPattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}",
      "Description": "Owner-reviewed cleanup date, YYYY-MM-DD; tag does not automate deletion."
    },
    "StagingDeletionProtection": {
      "Type": "String",
      "Default": "ACTIVE",
      "AllowedValues": [
        "ACTIVE",
        "INACTIVE"
      ],
      "Description": "Keep ACTIVE; INACTIVE only for separately approved staging teardown."
    },
    "EnableDisposableSelfSignUp": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ],
      "Description": "Keep false until disposable-account/email testing is separately approved; true opens self-sign-up during the approved window."
    }
  },
  "Rules": {
    "ApprovedAccountOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::AccountId"
              },
              {
                "Ref": "ApprovedAccountId"
              }
            ]
          },
          "AssertDescription": "Deployment must use the separately approved account."
        }
      ]
    },
    "WestRegionOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::Region"
              },
              "us-west-2"
            ]
          },
          "AssertDescription": "Staging must be deployed in us-west-2."
        }
      ]
    }
  },
  "Resources": {
    "StagingUserPool": {
      "Type": "AWS::Cognito::UserPool",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "UserPoolName": "crushx-auth-staging",
        "UserPoolTier": "LITE",
        "DeletionProtection": {
          "Ref": "StagingDeletionProtection"
        },
        "UsernameConfiguration": {
          "CaseSensitive": true
        },
        "AliasAttributes": [
          "email"
        ],
        "AutoVerifiedAttributes": [
          "email"
        ],
        "Schema": [
          {
            "Name": "email",
            "AttributeDataType": "String",
            "Mutable": true,
            "Required": true
          }
        ],
        "UserAttributeUpdateSettings": {
          "AttributesRequireVerificationBeforeUpdate": [
            "email"
          ]
        },
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 8,
            "RequireUppercase": true,
            "RequireLowercase": true,
            "RequireNumbers": true,
            "RequireSymbols": true,
            "TemporaryPasswordValidityDays": 1
          }
        },
        "MfaConfiguration": "OFF",
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [
            {
              "Name": "verified_email",
              "Priority": 1
            }
          ]
        },
        "EmailConfiguration": {
          "EmailSendingAccount": "COGNITO_DEFAULT"
        },
        "VerificationMessageTemplate": {
          "DefaultEmailOption": "CONFIRM_WITH_CODE",
          "EmailSubject": "Crush.X STAGING verification code",
          "EmailMessage": "Crush.X STAGING only. Your verification code is {####}. If you did not request this staging test, ignore this email."
        },
        "AdminCreateUserConfig": {
          "AllowAdminCreateUserOnly": {
            "Fn::If": [
              "DisposableSignupEnabled",
              false,
              true
            ]
          }
        },
        "UserPoolTags": {
          "Application": "Crush.X",
          "Environment": "staging",
          "Owner": {
            "Ref": "OwnerLabel"
          },
          "TestWindowEnd": {
            "Ref": "TestWindowEnd"
          },
          "Purpose": "disposable-auth-tests"
        }
      }
    },
    "StagingBrowserClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "ClientName": "crushx-auth-staging-browser",
        "UserPoolId": {
          "Ref": "StagingUserPool"
        },
        "GenerateSecret": false,
        "ExplicitAuthFlows": [
          "ALLOW_USER_SRP_AUTH",
          "ALLOW_REFRESH_TOKEN_AUTH"
        ],
        "PreventUserExistenceErrors": "ENABLED",
        "EnableTokenRevocation": true,
        "AuthSessionValidity": 3,
        "AccessTokenValidity": 60,
        "IdTokenValidity": 60,
        "RefreshTokenValidity": 5,
        "TokenValidityUnits": {
          "AccessToken": "minutes",
          "IdToken": "minutes",
          "RefreshToken": "days"
        },
        "ReadAttributes": [
          "email",
          "email_verified"
        ],
        "WriteAttributes": [
          "email"
        ],
        "AllowedOAuthFlowsUserPoolClient": false
      }
    }
  },
  "Outputs": {
    "StagingUserPoolId": {
      "Value": {
        "Ref": "StagingUserPool"
      }
    },
    "StagingBrowserClientId": {
      "Value": {
        "Ref": "StagingBrowserClient"
      }
    },
    "StagingUserPoolArn": {
      "Value": {
        "Fn::GetAtt": [
          "StagingUserPool",
          "Arn"
        ]
      }
    },
    "Region": {
      "Value": {
        "Ref": "AWS::Region"
      }
    },
    "AccountId": {
      "Value": {
        "Ref": "AWS::AccountId"
      }
    },
    "PoolName": {
      "Value": "crushx-auth-staging"
    }
  },
  "Conditions": {
    "DisposableSignupEnabled": {
      "Fn::Equals": [
        {
          "Ref": "EnableDisposableSelfSignUp"
        },
        "true"
      ]
    }
  }
}
