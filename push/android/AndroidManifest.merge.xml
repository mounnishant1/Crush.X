<!-- MERGE THESE ENTRIES INTO THE EXISTING FRONTEND ANDROID APP MANIFEST.
     Do not replace the actual launcher Activity or register two MESSAGING_EVENT services.
     Replace the package name below only if the project uses a different Java package. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application>
        <service
            android:name="in.crushx.notifications.CrushXMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
